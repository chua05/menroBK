NODE_ENV=test
PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
BACKEND_URL=http://localhost:5000
MENRO_INTEGRATION_TEST=true
GCLOUD_PROJECT=demo-menro-phase2
FIREBASE_PROJECT_ID=demo-menro-phase2
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
EVIDENCE_STORAGE_PROVIDER=local
EVIDENCE_DAILY_FILE_LIMIT=50
EVIDENCE_DAILY_BYTE_LIMIT=209715200
EVIDENCE_GLOBAL_DAILY_ALERT_BYTES=1073741824
# Optional Storage SDK checks require BOTH lines below. Never use the production bucket.
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_STORAGE_BUCKET=demo-menro-phase2.firebasestorage.app
MENRO_UPLOAD_ROOT=C:\Users\<you>\AppData\Local\Temp\menro-phase2-uploads
REQUEST_IDENTIFICATION_ENCRYPTION_KEY=<test-only-base64-encoded-32-byte-key>
