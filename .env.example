PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://menro-xxtt-five.vercel.app
ALLOW_VERCEL_PREVIEWS=false
VERCEL_FRONTEND_PROJECT=
VERCEL_FRONTEND_TEAM=
BACKEND_URL=http://localhost:5000
# Phase 1: evidence uploads/retrieval remain LOCAL. The firebase adapter is unavailable.
EVIDENCE_STORAGE_PROVIDER=local
# Phase 3 preparation only: not connected to application upload endpoints.
EVIDENCE_DAILY_FILE_LIMIT=50
EVIDENCE_DAILY_BYTE_LIMIT=209715200
EVIDENCE_GLOBAL_DAILY_ALERT_BYTES=1073741824
# Optional configuration only; does not enable cloud access or change evidence links.
FIREBASE_STORAGE_BUCKET=menrosystem-ddfac.firebasestorage.app
# Production GCS activation remains OFF. These values are deployment-checklist
# inputs only and must not be enabled before the reviewed activation checkpoint.
# MENRO_GCS_PRODUCTION=true
# EVIDENCE_STORAGE_PROVIDER=gcs
# EVIDENCE_CLOUD_WORKFLOW_ENABLED=true
# EVIDENCE_CLOUD_READ_ENABLED=true
# EVIDENCE_GCS_PRODUCTION_APPROVAL=AUTHORIZED_CONTROLLED_PRODUCTION_ACTIVATION
GUEST_INVITATION_SECRET=<strong-secret-at-least-32-characters>
MAIL_PROVIDER=resend
RESEND_API_KEY=<server-only-api-key>
EMAIL_FROM=MENRO Bulan <no-reply@your-verified-domain.example>
EMAIL_REPLY_TO=menro@bulan.gov.ph
REQUEST_IDENTIFICATION_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
# Staged rotation only. Keep the legacy variable above until all unkeyed records
# are migrated. IDs are non-secret labels; key values remain secrets.
# REQUEST_IDENTIFICATION_ENCRYPTION_KEY_ACTIVE=<base64-encoded-32-byte-key>
# REQUEST_IDENTIFICATION_ENCRYPTION_KEY_ACTIVE_ID=rotation-YYYY-NN
# REQUEST_IDENTIFICATION_ENCRYPTION_KEY_PREVIOUS=<base64-encoded-32-byte-key>
# REQUEST_IDENTIFICATION_ENCRYPTION_KEY_PREVIOUS_ID=legacy-v1
# Operator-only migration gates; never leave enabled after the bounded run.
# REQUEST_IDENTIFICATION_MIGRATION_ENABLED=true
# REQUEST_IDENTIFICATION_MIGRATION_APPROVAL=AUTHORIZED_REQUEST_IDENTIFICATION_KEY_MIGRATION
# Rollback only; keep absent for dry-run, execute, and reconciliation.
# REQUEST_IDENTIFICATION_MIGRATION_ROLLBACK_APPROVAL=AUTHORIZED_REQUEST_IDENTIFICATION_KEY_ROLLBACK

# Emulator-only integration testing (copy to a separate local environment file)
# MENRO_INTEGRATION_TEST=true
# GCLOUD_PROJECT=demo-menro-phase2
# FIREBASE_PROJECT_ID=demo-menro-phase2
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# MENRO_UPLOAD_ROOT=C:\\Users\\<you>\\AppData\\Local\\Temp\\menro-phase2-uploads

# Early Survival Monitoring is fail-closed. Leave unset in production until approved.
# Use a precise ISO instant when activation is authorized, for example:
# EARLY_MONITORING_ACTIVATION_AT=2026-11-01T00:00:00+08:00
