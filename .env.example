PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://menro-xxtt-five.vercel.app
ALLOW_VERCEL_PREVIEWS=false
VERCEL_FRONTEND_PROJECT=
VERCEL_FRONTEND_TEAM=
BACKEND_URL=http://localhost:5000
GUEST_INVITATION_SECRET=<strong-secret-at-least-32-characters>
MAIL_PROVIDER=resend
RESEND_API_KEY=<server-only-api-key>
EMAIL_FROM=MENRO Bulan <no-reply@your-verified-domain.example>
EMAIL_REPLY_TO=menro@bulan.gov.ph
REQUEST_IDENTIFICATION_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
# Optional staged rotation. Compatibility deployment requires none of these.
# REQUEST_IDENTIFICATION_ENCRYPTION_KEY_ACTIVE=<base64-encoded-32-byte-key>
# REQUEST_IDENTIFICATION_ENCRYPTION_KEY_ACTIVE_ID=rotation-YYYY-NN
# REQUEST_IDENTIFICATION_ENCRYPTION_KEY_PREVIOUS=<base64-encoded-32-byte-key>
# REQUEST_IDENTIFICATION_ENCRYPTION_KEY_PREVIOUS_ID=legacy-v1

# Emulator-only integration testing (copy to a separate local environment file)
# MENRO_INTEGRATION_TEST=true
# GCLOUD_PROJECT=demo-menro-phase2
# FIREBASE_PROJECT_ID=demo-menro-phase2
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# MENRO_UPLOAD_ROOT=C:\\Users\\<you>\\AppData\\Local\\Temp\\menro-phase2-uploads

# Early Survival Monitoring is fail-closed. Leave unset in production until approved.
# Use a precise ISO instant when activation is authorized, for example:
# EARLY_MONITORING_ACTIVATION_AT=2026-11-01T00:00:00+08:00
